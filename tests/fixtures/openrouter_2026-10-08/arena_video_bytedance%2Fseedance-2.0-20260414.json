-2.0-20260414/b37563dd-518c-46ea-8880-947362e08bff/frame-0-4.webp"],"mediaType":"video/mp4","width":1280,"height":720},"costUsd":1.2159,"durationMs":164984,"score":{"checks":[{"label":"Candle count","pass":true},{"label":"All lit at start","pass":true},{"label":"Left to right, one at a time","pass":true},{"label":"All out at end","pass":true},{"label":"No hand or person","pass":true}],"judges":[{"permaslug":"google/gemini-3.8-flash-20260902","name":"Google: Gemini 3.8 Flash","author":"google"}]}}]}]}},{"challenge":{"kind":"challenge","modality":"video","slug":"wrong-way-escalator","name":"Wrong-way escalator","navLabel":"Wrong-way escalator","description":"Two motions in opposite directions in one shot. The escalator rises while the ball bounces down against it, so the model has to keep both going without one dragging the other along.","variantAxisName":"Subject","variants":[{"slug":"wrong-way-escalator","name":"Wrong-way escalator","prompt":"A fixed shot of an empty upward-moving escalator. A single red rubber ball bounces down the escalator steps from top to bottom, against the direction of the escalator's movement, and exits the frame at the bottom. No people, no cuts.","inputAssets":[],"cells":[{"model":{"permaslug":"bytedance/seedance-2.0-20260414","name":"ByteDance: Seedance 2.0","author":"bytedance"},"provider":"Seed","asset":{"url":"https://model-assets.openrouter.ai/model-examples/bytedance/seedance-2.0-20260414/b7a04d49-b0a0-415e-a9f4-da17736f978c/original-0.mp4","thumbnailUrl":"https://model-assets.openrouter.ai/model-examples/bytedance/seedance-2.0-20260414/b7a04d49-b0a0-415e-a9f4-da17736f978c/thumb-0.webp","frameThumbnailUrls":["https://model-assets.openrouter.ai/model-examples/bytedance/seedance-2.0-20260414/b7a04d49-b0a0-415e-a9f4-da17736f978c/frame-0-0.webp","https://model-assets.openrouter.ai/model-examples/bytedance/seedance-2.0-20260414/b7a04d49-b0a0-415e-a9f4-da17736f978c/frame-0-1.webp","https://model-assets.openrouter.ai/model-examples/bytedance/seedance-2.0-20260414/b7a04d49-b0a0-415e-a9f4-da17736f978c/frame-0-2.webp","https://model-assets.openrouter.ai/model-examples/bytedance/seedance-2.0-20260414/b7a04d49-b0a0-415e-a9f4-da17736f978c/frame-0-3.webp","https://model-assets.openrouter.ai/model-examples/bytedance/seedance-2.0-20260414/b7a04d49-b0a0-415e-a9f4-da17736f978c/frame-0-4.webp"],"mediaType":"video/mp4","width":1280,"height":720},"costUsd":1.2159,"durationMs":736643,"score":{"checks":[{"label":"Escalator moves upward","pass":false},{"label":"Ball descends against steps","pass":false},{"label":"Single red ball persists","pass":true},{"label":"Exits at bottom","pass":true},{"label":"No people","pass":true}],"judges":[{"permaslug":"google/gemini-3.8-flash-20260902","name":"Google: Gemini 3.8 Flash","author":"google"}]}}]}]}},{"challenge":{"kind":"challenge","modality":"video","slug":"frozen-crowd","name":"Frozen crowd","navLabel":"Frozen crowd","description":"Video models want to move people. A crowd that stays perfectly still while only the flags move tests whether the model can suppress motion on command rather than just generate it.","variantAxisName":"Subject","variants":[{"slug":"frozen-crowd","name":"Frozen crowd","prompt":"A busy pedestrian plaza in daylight where every single person stands perfectly still like a statue for the entire clip. Only the flags on the buildings move in the wind. No person moves at all, not even slightly. Fixed camera, no cuts.","inputAssets":[],"cells":[{"model":{"permaslug":"bytedance/seedance-2.0-20260414","name":"ByteDance: Seedance 2.0","author":"bytedance"},"provider":"Seed","asset":{"url":"https://model-assets.openrouter.ai/model-examples/bytedance/seedance-2.0-20260414/1e83d5ba-c755-45fc-86e0-9f4b81e183d1/original-0.mp4","thumbnailUrl":"https://model-assets.openrouter.ai/model-examples/bytedance/seedance-2.0-20260414/1e83d5ba-c755-45fc-86e0-9f4b81e183d1/thumb-0.webp","frameThumbnailUrls":["https://model-assets.openrouter.ai/model-examples/bytedance/seedance-2.