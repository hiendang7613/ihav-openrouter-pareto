{"data":{"pages":[{"challenge":{"kind":"challenge","modality":"video","slug":"traffic-light","name":"Traffic light","navLabel":"Traffic light","description":"Red, then green, then amber is not the real-world order. Models that lean on what traffic lights usually do will get it wrong, so this tests whether a video model follows a stated sequence.","variantAxisName":"Subject","variants":[{"slug":"traffic-light","name":"Traffic light","prompt":"A fixed camera on a single traffic light against a plain grey sky. The light starts red, changes to green, and then changes to amber, in that exact order, each colour holding for a clearly visible moment. No other objects, no camera movement, no cuts.","inputAssets":[],"cells":[{"model":{"permaslug":"bytedance/seedance-2.0-20260414","name":"ByteDance: Seedance 2.0","author":"bytedance"},"provider":"Seed","asset":{"url":"https://model-assets.openrouter.ai/model-examples/bytedance/seedance-2.0-20260414/6eaa3b73-9c93-425d-8409-c1dae2ce0fd8/original-0.mp4","thumbnailUrl":"https://model-assets.openrouter.ai/model-examples/bytedance/seedance-2.0-20260414/6eaa3b73-9c93-425d-8409-c1dae2ce0fd8/thumb-0.webp","frameThumbnailUrls":["https://model-assets.openrouter.ai/model-examples/bytedance/seedance-2.0-20260414/6eaa3b73-9c93-425d-8409-c1dae2ce0fd8/frame-0-0.webp","https://model-assets.openrouter.ai/model-examples/bytedance/seedance-2.0-20260414/6eaa3b73-9c93-425d-8409-c1dae2ce0fd8/frame-0-1.webp","https://model-assets.openrouter.ai/model-examples/bytedance/seedance-2.0-20260414/6eaa3b73-9c93-425d-8409-c1dae2ce0fd8/frame-0-2.webp","https://model-assets.openrouter.ai/model-examples/bytedance/seedance-2.0-20260414/6eaa3b73-9c93-425d-8409-c1dae2ce0fd8/frame-0-3.webp","https://model-assets.openrouter.ai/model-examples/bytedance/seedance-2.0-20260414/6eaa3b73-9c93-425d-8409-c1dae2ce0fd8/frame-0-4.webp"],"mediaType":"video/mp4","width":1280,"height":720},"costUsd":1.2159,"durationMs":165692,"score":{"checks":[{"label":"Starts red","pass":true},{